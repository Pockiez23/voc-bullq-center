PORT=3000

# Prisma uses this for `prisma db pull`, `prisma migrate`, and runtime connections.
# Replace with your real credentials/host/port/db.
#DATABASE_URL="postgresql://pea_voc_staging_user:<PASSWORD>@10.4.34.123:50384/pea_voc_staging"
DATABASE_URL="postgresql://voc:vocpass@localhost:5432/voc_pea_clone?schema=public"

# VOC 1129 Cron interval (minutes)
VOC_1129_CRON_INTERVAL_MINUTES="ระยะเวลาที่จะรันงานต่อครั้ง" # ระยะเวลาที่จะรันงานต่อครั้ง เช่น 30
BATCH_SIZE="จำนวนงานที่จะส่งต่อคิวต่อรอบ" # จำนวนงานที่จะส่งต่อคิวต่อรอบ เช่น 10
# ตั้งค่า URL สำหรับยิง SOAP
SOAP_ENDPOINT="ใส่_URL_ปลายทางที่นี่"